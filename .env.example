# Copy to .env (git-ignored). Placeholders only — never commit real secrets.

# --- App settings (backend/app/core/config.py) ---
ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://blog:blog@db:5432/blog
TEST_DATABASE_URL=postgresql+psycopg://blog:blog@db:5432/blog_test
JWT_SECRET=local-dev-only-secret-change-me-0123456789
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
